{
  "name": "@accountability/identity-policy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./intake-service-adapter": {
      "types": "./dist/intake-service-adapter.d.ts",
      "default": "./dist/intake-service-adapter.js"
    },
    "./revocations": {
      "types": "./dist/revocations.d.ts",
      "default": "./dist/revocations.js"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
